# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Game Cover API (RAWG)
VITE_RAWG_API_KEY=your-rawg-api-key

# Web Push (reminders) — VAPID public key. Generate with: npx web-push generate-vapid-keys
# The public key is safe to expose in the client. Keep the private key in Supabase secrets only.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

